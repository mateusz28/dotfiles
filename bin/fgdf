#!/bin/bash

is_in_git_repo() {
  git rev-parse HEAD > /dev/null 2>&1
}

is_in_git_repo || { echo "Not in a git dir"; exit 1; }

cd $(git rev-parse --show-toplevel)

if [ -n "$1" ]; then
  commit="$1"
else
  commit="HEAD"
fi

preview="echo {+} | sed 's/^\(.*\)|.*$/\1/;s/^[   ]*//;s/[    ]*$//' | xargs -I % sh -c 'git diff --color=always \"$commit\" \"%\" | tail -n +4'"

git diff --color=always --compact-summary --stat=1000 --no-commit-id "$commit" | sed '$d' |
  fzf --ansi --print0 --no-sort --reverse --preview-window=nohidden --preview "$preview" --tiebreak=index --bind=ctrl-s:toggle-sort \
      --bind "ctrl-m:execute:
                (echo {s} | cut -d \| -f 1 |
                xargs -I % sh -c 'git difftool -y \"$commit\" -- %') << 'FZF-EOF'
                {}
FZF-EOF"
