#!/bin/bash
# fcs - get git commit sha
# example usage: git rebase -i `fcs`
fcs() {
  local commits commit
  commits=$(git log --color=always --decorate=short --pretty=format:'%C(yellow)%h%C(auto)%d%C(reset) %s' --abbrev-commit --reverse) &&
  commit=$(echo "$commits" | fzf --tac +s +m -e --ansi --reverse \
    --preview 'git show --stat --color=always --format=fuller {1}' \
    --preview-window=right:60%:wrap \
    --bind '?:toggle-preview') &&
  git rebase -i $(echo "$commit" | sed "s/ .*//")
}
fcs
